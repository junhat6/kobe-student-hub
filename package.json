{
  "name": "kobe-student-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "wrangler deploy --dry-run --outdir .worker && node scripts/build-test-fixtures.mjs && vitest run",
    "test:e2e": "playwright test",
    "db:local": "wrangler d1 migrations apply kobe-student-hub-preview --local && wrangler d1 execute kobe-student-hub-preview --local --file content-revisions/0001_git_practice.sql && wrangler d1 execute kobe-student-hub-preview --local --file content-revisions/0002_learning_notes.sql",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy:production": "node scripts/deploy-production-disabled.mjs",
    "types": "wrangler types --include-runtime=false",
    "deploy:prepare": "node scripts/prepare-deploy.mjs",
    "editor:build": "vite build --config vite.editor.config.ts",
    "editor:preview": "node scripts/editor-preview.mjs",
    "test:editor": "playwright test --config playwright.editor.config.ts",
    "deploy:preview": "node scripts/prepare-deploy.mjs --for-deploy && npm run build && wrangler deploy --config .wrangler/preview.deploy.json",
    "production:prepare": "node scripts/prepare-production.mjs",
    "test:pending-pilot": "playwright test --config playwright.pilot.config.ts",
    "test:auth-browser": "playwright test --config playwright.generation.config.ts",
    "test:retired-trial": "playwright test --config playwright.retired-trial.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261103.0-beta",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
