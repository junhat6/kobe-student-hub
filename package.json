{
  "name": "kobe-student-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "wrangler deploy --dry-run --outdir .worker && node scripts/build-test-fixtures.mjs && vitest run",
    "test:e2e": "playwright test",
    "db:local": "wrangler d1 migrations apply kobe-student-hub-preview --local && wrangler d1 execute kobe-student-hub-preview --local --file content-revisions/0001_git_practice.sql && wrangler d1 execute kobe-student-hub-preview --local --file content-revisions/0002_learning_notes.sql && wrangler d1 execute kobe-student-hub-preview --local --file content-revisions/0003_learning_notes_decisions.sql && wrangler d1 execute kobe-student-hub-preview --local --file content-revisions/0004_learning_notes_no_assignment.sql",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy:production": "node scripts/deploy-production.mjs",
    "types": "wrangler types --include-runtime=false",
    "deploy:prepare": "node scripts/prepare-deploy.mjs",
    "editor:build": "vite build --config vite.editor.config.ts",
    "editor:preview": "node scripts/editor-preview.mjs",
    "test:editor": "playwright test --config playwright.editor.config.ts",
    "deploy:preview": "node scripts/prepare-deploy.mjs --for-deploy && npm run build && wrangler deploy --config .wrangler/preview.deploy.json",
    "test:auth-browser": "playwright test --config playwright.generation.config.ts",
    "test:retired-trial": "playwright test --config playwright.retired-trial.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node .husky/install.mjs",
    "lint:staged": "lint-staged",
    "release": "node scripts/release.mjs",
    "release:report": "node scripts/loop/release-log.mjs",
    "release:log": "node scripts/loop/release-log.mjs",
    "smoke": "node scripts/loop/smoke.mjs",
    "look": "node scripts/loop/look.mjs",
    "look:review": "node scripts/loop/look-review.mjs",
    "production:config": "node scripts/production-wrangler.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/commands": "^6.11.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "6.43.15",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/png": "3.1.1",
    "hono": "^4.13.19",
    "jose": "^6.2.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.6",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "^5.20261115.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "fast-png": "8.0.0",
    "husky": "9.1.7",
    "jpeg-js": "0.4.4",
    "lint-staged": "17.6.1",
    "miniflare": "^5.20261103.0-beta",
    "prettier": "3.10.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.162.0"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,css,html,json,jsonc,yml,yaml}": "prettier --write --ignore-unknown"
  },
  "overrides": {
    "miniflare": {
      "ws": "^8.23.0",
      "undici": "^7.30.2"
    }
  }
}
