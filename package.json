{
  "name": "kobe-student-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "wrangler deploy --dry-run --outdir .worker && node scripts/build-test-fixtures.mjs && vitest run",
    "test:e2e": "playwright test",
    "db:local": "wrangler d1 migrations apply kobe-student-hub-preview --local",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy:production": "node scripts/check-remote-config.mjs && npm run build && wrangler d1 migrations apply kobe-student-hub-preview --remote && wrangler deploy",
    "types": "wrangler types --include-runtime=false"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261103.0-beta",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
