{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kobe-student-hub-preview",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/trial-assets", "/trial-assets/*"] },
  "d1_databases": [{"binding":"DB","database_name":"kobe-student-hub-preview","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}],
  "observability": {"enabled":true,"head_sampling_rate":0.1,"redact_query_string":true}
}
